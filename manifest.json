{
  "manifest_version": 3,
  "name": "GraphQL Debugger",
  "description": "Debug GraphQL in DevTools: pause and edit requests, reveal Apollo APQ queries, explore the schema.",
  "version": "5.0.0",
  "minimum_chrome_version": "123",
  "permissions": ["contextMenus", "debugger", "storage", "tabs", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "./js/service-worker.min.js"
  },
  "action": {
    "default_title": "Toggle GraphQL Debugger"
  },
  "devtools_page": "./frontend/devtools.html",
  "icons": {
    "16": "./icons/icon16.png",
    "32": "./icons/icon32.png",
    "48": "./icons/icon48.png",
    "128": "./icons/icon128.png"
  }
}
