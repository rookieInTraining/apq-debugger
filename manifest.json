{
  "manifest_version": 3,
  "name": "Apollo GraphQL Persisted Queries (APQ) Debugger",
  "description": "Reveal full GraphQL queries behind Apollo APQ hashes. Inspect fallback flow and debug Automatic Persisted Queries in DevTools.",
  "tag": ["chrome-extension", "graphql", "apollo-client", "persisted-queries", "apq", "devtools", "debugging", "apq-debugger"],
  "version": "1.0.0",
  "permissions": ["debugger", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "./js/service-worker.min.js"
  },
  "devtools_page": "./frontend/devtools.html",
  "icons": {
    "16": "./icons/icon16.png",
    "32": "./icons/icon32.png",
    "48": "./icons/icon48.png",
    "128": "./icons/icon128.png"
  }
}